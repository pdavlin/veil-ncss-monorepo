{% extends "layouts/base.njk" %}
{#
  Portfolio detail page.

  Frontmatter contract (flat, top-level):
    title          string                       project name
    date           YYYY-MM-DD                   date added (drives ordering)
    location?      string                       e.g. "Omaha, NE"
    cardImage      { src, alt }                 used by portfolio-grid + home recent-projects
    metadata?      [{ label, value }]           Architect / Engineer / etc.
    featuredVideo? { src?, youtube?, poster?, alt, style? } featured-project video.
                                                style 'hero' (default): full-bleed autoplay
                                                hero with the title + location over it.
                                                style 'inline': a prose-width player under
                                                the title. youtube (a YouTube URL) shows an
                                                inline YouTube player in place of src/style
    media?         [{ type, src, poster?, alt }]   hero gallery for the detail page
    mediaCredit?   string                       under the gallery; after the metadata
                                                when there is no gallery

  Prev/next links are derived at render time from `collections.projects`
  (sorted by date desc — see .eleventy.js).

  The markdown body becomes the project description (rendered as `content`).
#}
{% block content %}
  {%- set _youtubeId = (featuredVideo.youtube if featuredVideo else '') | youtubeId %}
  {%- set _videoHero = featuredVideo and featuredVideo.src and not _youtubeId and featuredVideo.style != 'inline' %}
  {%- if _videoHero %}
    {% set hero = { heading: title, titleMark: true, eyebrow: location, video: featuredVideo, overlayPosition: 'left', scrim: 'bottom' } %}
    {% include "hero-overlay.njk" %}
  {% endif %}

  <section class="page-section">
    <div class="page-section__inner">
      {% set backLink = { label: 'Back', href: '/portfolio/' } %}
      {% include "back-link.njk" %}

      {#- the video hero already carries the title and location #}
      {%- if not _videoHero %}
        <p class="kicker" style="margin-block-start: var(--space-m);">portfolio.</p>
        {% set pageTitle = { text: title, as: 'h1' } %}
        {% include "page-title.njk" %}

        {% if location %}<p class="kicker" style="margin-block-start: var(--space-2xs);">{{ location }}</p>{% endif %}
      {% endif %}

      {% if _youtubeId %}
        <div class="project-media project-media--single" data-component="project-media" style="max-width: var(--measure-prose); margin-block-start: var(--space-m);">
          <iframe
            class="project-media__embed"
            src="https://www.youtube-nocookie.com/embed/{{ _youtubeId }}"
            title="{{ featuredVideo.alt or title }}"
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      {% elif featuredVideo and featuredVideo.src and not _videoHero %}
        <div class="project-media project-media--single" data-component="project-media" style="max-width: var(--measure-prose); margin-block-start: var(--space-m);">
          <video
            class="project-media__video"
            controls
            preload="metadata"
            {% if featuredVideo.poster %}poster="{{ featuredVideo.poster }}"{% endif %}
            aria-label="{{ featuredVideo.alt or title }}"
          >
            <source src="{{ featuredVideo.src }}" type="video/mp4" />
          </video>
        </div>
      {% endif %}

      {% if content %}
        <div class="prose__body" style="max-width: var(--measure-prose); margin-block-start: var(--space-m);">
          {{ content | safe }}
        </div>
      {% endif %}

      {% if metadata and metadata.length %}
        <div style="margin-block-start: var(--space-l); max-width: var(--measure-prose);">
          {% set metadata = metadata %}
          {% include "project-metadata.njk" %}
        </div>
      {% endif %}

      {#- with no gallery the credit has nowhere else to go, so it follows the metadata #}
      {%- if mediaCredit and not (media and media.length) %}
        <p class="kicker" style="margin-block-start: var(--space-m);">{{ mediaCredit }}</p>
      {% endif %}
    </div>
  </section>

  {% if media and media.length %}
    <section class="page-section">
      <div class="page-section__inner">
        {% set media = media %}
        {% include "project-media.njk" %}
        {% if mediaCredit %}<p class="kicker" style="margin-block-start: var(--space-s); text-align: center;">{{ mediaCredit }}</p>{% endif %}
      </div>
    </section>
  {% endif %}

  {# derive prev/next from the projects collection (sorted by date desc) #}
  {% set _projects = collections.projects %}
  {% set _idx = -1 %}
  {% for entry in _projects %}
    {% if entry.url == page.url %}{% set _idx = loop.index0 %}{% endif %}
  {% endfor %}
  {% if _idx >= 0 %}
    {% set _prev = _projects[_idx - 1] if _idx > 0 else null %}
    {% set _next = _projects[_idx + 1] if _idx < (_projects.length - 1) else null %}
    {% if _prev or _next %}
      {% set pagination = {
        prev: { label: _prev.data.title, href: _prev.url } if _prev else null,
        next: { label: _next.data.title, href: _next.url } if _next else null
      } %}
      {% include "prev-next-pagination.njk" %}
    {% endif %}
  {% endif %}
{% endblock %}
