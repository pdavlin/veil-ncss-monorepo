{% extends "layouts/base.njk" %}
{#
  Manufacturers page — services-style shell: intro rail on the left, numbered
  category cards on the right. Each card holds the category copy, grouped
  manufacturer name lists, and a logo wall.

  Frontmatter contract (flat, top-level):
    title          string                             page <title>
    titleText?     string                             page-title text, default "manufacturers"
    intro?         string (markdown)                  left-rail intro copy
    categories?    [{
      title        string                             e.g. "roller shades"
      body?        string (markdown)                  category description
      lists?       [{ heading?, items: [string] }]    manufacturer names; heading labels a group (e.g. "Hardware:")
      logos?       [{ src, alt }]                     logo-grid tiles; alt = company name
    }]

  Cards are numbered by position, so reordering categories renumbers them.
  Built only from shared components (page-title, numbered-service-card,
  logo-grid) and the services page shell, so any brand can adopt it unchanged.
#}
{% block content %}
  <section class="page-section">
    <div class="page-section__inner">
      {% set pageTitle = { text: titleText or 'manufacturers', as: 'h1' } %}
      {% include "page-title.njk" %}
      <div class="stack-grid stack-grid--services" style="margin-block-start: var(--space-l);">
        <div class="services-sidebar">
          {% if intro %}
            <div class="services-sidebar__intro prose__body">{{ intro | md | safe }}</div>
          {% endif %}
        </div>
        <ul class="service-list">
          {% for category in categories %}
            {% set _body %}
              {% if category.body %}{{ category.body | md | safe }}{% endif %}
              {% for list in category.lists %}
                {% if list.heading %}<p><strong>{{ list.heading }}</strong></p>{% endif %}
                {% if list.items and list.items.length %}
                  <div class="deliverables-list">
                    {% for item in list.items %}<p>{{ item }}</p>{% endfor %}
                  </div>
                {% endif %}
              {% endfor %}
              {% if category.logos and category.logos.length %}
                {% set logoGrid = { label: category.title ~ ' manufacturers', logos: category.logos } %}
                {% include "logo-grid.njk" %}
              {% endif %}
            {% endset %}
            <li>
              {% set service = { number: loop.index, title: category.title, body: _body | safe, numberLabel: 'Category' } %}
              {% include "numbered-service-card.njk" %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>
{% endblock %}
